{
  "name": "echogrow",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "npm install && npm run build:shared && npm run prisma:generate",
    "build:shared": "npm run build -w @echogrow/shared",
    "prisma:generate": "npm exec -w api -- prisma generate",
    "dev:shared": "npm run dev -w @echogrow/shared",
    "dev:api": "npm run start:dev -w api",
    "dev:web": "npm run dev -w web",
    "build": "npm run build:shared && npm run build -w api && npm run build -w web"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "rimraf": "^6.0.0"
  },
  "dependencies": {
    "@rolldown/binding-linux-x64-gnu": "^1.0.0",
    "lightningcss-linux-x64-gnu": "^1.32.0",
    "@lilac-labs/words-to-numbers": "^2.1.5"
  }
}
